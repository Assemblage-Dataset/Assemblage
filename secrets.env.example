# Copy to secrets.env (gitignored) and fill in real values.
# Every service in docker-compose.yml loads this via env_file.

DB_HOST=assemblage-db
DB_PORT=5432
POSTGRES_DATABASE=assemblage
# Do not change the user: backend/alembic/env.py and the init flow assume it.
POSTGRES_USER=assemblage
POSTGRES_PASSWORD=change-me

# Fine-grained PAT with public-repo read scope only — the scraper just
# searches and clones public repositories.
GITHUB_TOKEN=

# MinIO (S3_* is what the workers read; MINIO_ROOT_* configures the server).
S3_HOST=minio
S3_HTTPS=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_ACCESS_KEY=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# RabbitMQ credentials (default guest/guest; workers and the broker both
# read these once the settings rewrite lands).
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
