# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store

# --- Environments / secrets --------------------------------------------------
.env
*secrets.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Tooling caches ----------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
__pycache__/
*.pyc

# --- Logs / temp -------------------------------------------------------------
*.log
.tmp/
.bin/
/var/
build_msgs.txt
dump_*
local_config/
/.assemblage-tui.json

# --- Generated compose (retired in the infra phase) --------------------------
docker-compose-tui.yml

# --- Data stores (never source, wherever they appear) -------------------------
*.db
*.db_shm
*.db_wal
*.sqlite
*.sqlite3
*.duckdb
*.duckdb.zst
*.zst
db-data/

# --- Pipeline byproducts ------------------------------------------------------
*.dwarf.json
*.pcode
*.metadata
*.stdout

# --- Large local data, anchored to where it actually lives --------------------
# (winpe.sqlite 102 GB, hf_binaries/ 361 GB, binaries/ is a live MinIO backend,
#  data_refill/ holds a 136 GB duckdb; none of it is source)
/winpe.sqlite*
/hf_binaries/
/binaries/
/assemblage_dataset/
/restart_loop.log
/data_refill/*
!/data_refill/*.py
!/data_refill/README.md
/frontend/

# deephistory: runtime data only — source under deephistory/ stays tracked
deephistory/binaries/
deephistory/claims/
deephistory/progress/
deephistory/deephistory/
deephistory/*.sqlite*
!deephistory/packages.json

# --- Test fixtures are always tracked, whatever their extension ---------------
!tests/fixtures/**
!backend/test/**/*.json

# --- Design docs stay out of the repo (owner decision 2026-07-16) -------------
/RUST_WORKER_DESIGN.md
*_DESIGN.md
/RE-ARCHITECTURE.md
/CLAUDE.md
